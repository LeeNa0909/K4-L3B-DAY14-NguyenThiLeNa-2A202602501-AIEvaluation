# Used only by domain_assistant.py when generating real RAG answers through OpenRouter.
# Copy this file to .env, then replace the placeholder value.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter ranking metadata.
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=OrbitTech Evaluation Lab
